# ============================================================
# Network Surveillance Agent — Configuration
# Copie ce fichier en .env et remplis tes valeurs
# IMPORTANT : Ne jamais partager le fichier .env !
# ============================================================

# Clé API OpenAI (obligatoire pour l'analyse IA)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Réseau à surveiller (laisser vide = détection automatique)
NETWORK_RANGE=

# Port du serveur web (défaut: 5000)
FLASK_PORT=5000

# Mode debug Flask (mettre False en production)
FLASK_DEBUG=False

# Intervalle de surveillance continue en secondes (défaut: 300 = 5 min)
SCAN_INTERVAL=300

# Modèle OpenAI à utiliser
OPENAI_MODEL=gpt-4o-mini
